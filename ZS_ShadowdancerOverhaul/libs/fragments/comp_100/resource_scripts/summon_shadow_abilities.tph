COPY_EXISTING ~zs#sdsa#.spl~ ~override~ // Shadow Fade
    LPF ALTER_SPELL INT_VAR name=RESOLVE_STR_REF(@198) desc=RESOLVE_STR_REF(@199) END

COPY_EXISTING ~zs#sdsa.spl~ ~override~ // Normal Fade
    LPF ALTER_SPELL INT_VAR name=RESOLVE_STR_REF(@200) desc=RESOLVE_STR_REF(@201) END

COPY_EXISTING ~zs#sdsi.spl~ ~override~ // Fade Improved
    LPF ALTER_SPELL INT_VAR name=RESOLVE_STR_REF(@212) desc=RESOLVE_STR_REF(@213) END


    LPF ALTER_SPELL INT_VAR name=RESOLVE_STR_REF(@204) desc=RESOLVE_STR_REF(@205) END

COPY_EXISTING ~zs#sdsf.spl~ ~override~ // Teleport without error
    LPF ALTER_SPELL INT_VAR name=RESOLVE_STR_REF(@206) desc=RESOLVE_STR_REF(@207) END


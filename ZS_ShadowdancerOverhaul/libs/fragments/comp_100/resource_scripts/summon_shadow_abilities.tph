ADD_PROJECTILE ~%MOD_FOLDER%/projectiles/zssddark.pro~

COPY_EXISTING ~zs#sdsh.spl~ ~override~ // Darkness 15' feet
    LPF ALTER_SPELL INT_VAR name=RESOLVE_STR_REF(@210) desc=RESOLVE_STR_REF(@211) END
    LPF ALTER_HEADER INT_VAR match_type = 1 projectile = %zssddark% END


    LPF ALTER_SPELL INT_VAR name=RESOLVE_STR_REF(@208) desc=RESOLVE_STR_REF(@209) END
    LPF ALTER_EFFECT INT_VAR match_opcode = 139 parameter1=RESOLVE_STR_REF(@20209) END


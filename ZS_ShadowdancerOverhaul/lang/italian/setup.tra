@702 = ~Nuova abilità attiva ottenuta: Evocare Ombra~
@703 = ~Nuova abilità attiva ottenuta: Elusione d'Ombra~
@704 = ~Nuova abilità attiva ottenuta: Richiamo d'Ombra~


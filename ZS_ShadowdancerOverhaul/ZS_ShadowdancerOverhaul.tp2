BACKUP "weidu_external/backup/ZS_ShadowdancerOverhaul"
SUPPORT "Kaelyn at Gibberlings's forum https://www.gibberlings3.net/profile/12720-kaelyn/ or at kaelyn@tuta.io"
VERSION "1.3.1"
README ~%MOD_FOLDER%/readme.md~
AUTO_EVAL_STRINGS
ASK_EVERY_COMPONENT
ALWAYS
	OUTER_SPRINT root "%MOD_FOLDER%"
	OUTER_SPRINT libs "%root%/libs"
	OUTER_SPRINT fragments "%libs%/fragments"
	INCLUDE ~%fragments%/zs_always.tph~
END
LANGUAGE
	"English"
	"english"
	"ZS_ShadowdancerOverhaul/lang/english/setup.tra"
LANGUAGE
	"Simplified Chinese"
	"schinese"
	"ZS_ShadowdancerOverhaul/lang/schinese/setup.tra"

BEGIN @1000 LABEL ~zs_shadowdancer_overhaul~ DESIGNATED 100 // MAIN COMPONENT
REQUIRE_PREDICATE GAME_IS "iwdee bgee bg2ee eet" @10000

BEGIN @1005 LABEL ~zs_sd_spirit_form~ DESIGNATED 5000 // SPIRIT FORM CONSISTENCY TWEAK
REQUIRE_PREDICATE GAME_IS "iwdee bgee bg2ee eet" @10000
REQUIRE_COMPONENT "ZS_ShadowdancerOverhaul.tp2" "100" @10003

BEGIN @1010 LABEL ~zs_sd_rr_compat~ DESIGNATED 5001 // RR COMPATIBILITY FOR VANILLA SD
REQUIRE_PREDICATE GAME_IS "iwdee bgee bg2ee eet" @10000
